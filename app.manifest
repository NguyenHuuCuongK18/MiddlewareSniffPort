<?xml version="1.0" encoding="utf-8"?>
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
	<assemblyIdentity version="1.0.0.0" name="MiddlewareTest" type="win32" />

	<!-- Trust info with asm.v3 namespace — requestedExecutionLevel must live here -->
	<trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
		<security>
			<requestedPrivileges>
				<!-- choose one: requireAdministrator, highestAvailable, or asInvoker -->
				<requestedExecutionLevel level="requireAdministrator" uiAccess="false" />
			</requestedPrivileges>
		</security>
	</trustInfo>

	<compatibility xmlns="urn:schemas-microsoft-com:asm.v3">
		<application>
			<!-- Windows 10/11 identifiers (keeps compatibility entries) -->
			<supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
			<supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d5c3d2}"/>
		</application>
	</compatibility>
</assembly>
